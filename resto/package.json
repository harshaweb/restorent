{
  "name": "resto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --env-file-if-exists=.env server.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prod": "npm run build && npm start",
    "start:prod": "node --env-file-if-exists=.env scripts/start-prod.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
